                    <option value="Перец сладкий">Перец сладкий</option>
                    <option value="Перец острый">Перец острый</option>
                    <option value="Баклажаны">Баклажаны</option>
                    <option value="Лук репчатый">Лук репчатый</option>
                    <option value="Лук зелёный">Лук зелёный</option>
                    <option value="Чеснок">Чеснок</option>
                    <option value="Салат">Салат</option>
                    <option value="Шпинат">Шпинат</option>
                    <option value="Укроп">Укроп</option>
                    <option value="Петрушка">Петрушка</option>
                    <option value="Кинза">Кинза</option>
                    <option value="Арбуз">Арбуз</option>
                    <option value="Дыня">Дыня</option>
                    <option value="Яблоки">Яблоки</option>
                    <option value="Груши">Груши</option>
                    <option value="Сливы">Сливы</option>
                    <option value="Абрикосы">Абрикосы</option>
                    <option value="Персики">Персики</option>
                    <option value="Виноград">Виноград</option>
                    <option value="Клубника">Клубника</option>
                    <option value="Малина">Малина</option>
                    <option value="Смородина">Смородина</option>
                    <option value="Крыжовник">Крыжовник</option>
                    <option value="Голубика">Голубика</option>
                    <option value="Ежевика">Ежевика</option>
                </select>
                <input type="submit" name="forecast_submit" value="Прогнозировать урожайность">
            </form>
            <input type="button" name="location_button" value="Определить местоположение" onclick="getLocationAndForecast()">
            <form method="POST" action="/clear_history">
                <input type="submit" name="clear_history" value="Очистить историю">
            </form>
            {% if forecast_result %}
            <div class="response {{ forecast_result.yield_category }}">
                <h3>Прогноз урожайности:</h3>
                <p>Качество урожая: 
                    {% if forecast_result.yield_category == 'excellent' %}Отличный
                    {% elif forecast_result.yield_category == 'average' %}Средний
                    {% else %}Плохой
                    {% endif %}
                </p>
                <p>Местоположение: {{ location }}</p>
                <p>Урожайность на гектар: {{ forecast_result.yield_per_ha }} т/га</p>
                <p>Общая урожайность: {{ forecast_result.total_yield }} т</p>
                <p>Корректировка по температуре: {{ forecast_result.temp_adjustment }}%</p>
                <p>Корректировка по осадкам: {{ forecast_result.precip_adjustment }}%</p>
                <p>Корректировка по типу почвы: {{ forecast_result.soil_adjustment }}%</p>
                <p>Корректировка по удобрениям: {{ forecast_result.fertilizer_adjustment }}%</p>
                {% if plot_data %}
                <img src="data:image/png;base64,{{ plot_data }}" class="plot-img" alt="График урожайности">
                {% endif %}
                <div class="chart-container">
                    <canvas id="yieldChart"></canvas>
                </div>
            </div>
            {% endif %}
            {% if forecast_error %}
            <div class="response">
                <h3>Ошибка:</h3>
                <p>{{ forecast_error }}</p>
            </div>
            {% endif %}
            {% if forecast_history %}
            <div class="response">
                <h3>История прогнозов:</h3>
                <div class="filter-container">
                    <label for="category-filter">Фильтр по качеству урожая: </label>
                    <select id="category-filter" onchange="filterHistory()">
                        <option value="all">Все</option>
                        <option value="excellent">Отличный</option>
                        <option value="average">Средний</option>
                        <option value="poor">Плохой</option>
                    </select>
                </div>
                <div class="history-table-container">
                    <table class="history-table">
                        <tr>
                            <th>Культура</th>
                            <th>Местоположение</th>
                            <th>Температура (°C)</th>
                            <th>Осадки (мм)</th>
                            <th>Площадь (га)</th>
                            <th>Тип почвы</th>
                            <th>Уровень удобрений</th>
                            <th>Урожайность (т/га)</th>
                            <th>Общая урожайность (т)</th>
                            <th>Дата</th>
                        </tr>
                        {% for forecast in forecast_history %}
                        <tr class="{{ forecast.yield_category }}">
                            <td>{{ forecast.crop }}</td>
                            <td>{{ forecast.location }}</td>
                            <td>{{ forecast.avg_temp }}</td>
                            <td>{{ forecast.total_precipitation }}</td>
                            <td>{{ forecast.area }}</td>
                            <td>{{ forecast.soil_type }}</td>
                            <td>{{ forecast.fertilizer_level }}</td>
                            <td>{{ forecast.yield_per_ha }}</td>
                            <td>{{ forecast.total_yield }}</td>
                            <td>{{ forecast.timestamp }}</td>
                        </tr>
                        {% endfor %}
                    </table>
                </div>
            </div>
            {% endif %}
        </div>
    </section>
    <script>
        // Функция для переключения темы
        function toggleTheme() {
            const body = document.body;
            if (body.classList.contains('light-theme')) {
                body.classList.remove('light-theme');
                body.classList.add('dark-theme');
                localStorage.setItem('theme', 'dark');
            } else {
                body.classList.remove('dark-theme');
                body.classList.add('light-theme');
                localStorage.setItem('theme', 'light');
            }
        }

        // Загрузка сохранённой темы при загрузке страницы
        document.addEventListener('DOMContentLoaded', function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            document.body.classList.add(savedTheme + '-theme');
        });

        function updateTime() {
            const now = new Date();
            const day = String(now.getDate()).padStart(2, '0');
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const year = now.getFullYear();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            const timeString = `Текущее время: ${day}.${month}.${year} ${hours}:${minutes}:${seconds}`;
            document.getElementById('current-time').textContent = timeString;
        }
        setInterval(updateTime, 1000);
        updateTime();

        function validateForecastForm() {
            const avgTemp = parseFloat(document.getElementById('avg-temp').value);
            const totalPrecip = parseFloat(document.getElementById('total-precipitation').value);
            const area = parseFloat(document.getElementById('area').value);
            if (avgTemp < -50 || avgTemp > 50) {
                alert('Средняя температура должна быть в диапазоне от -50°C до 50°C!');
                return false;
            }
            if (totalPrecip < 0) {
                alert('Количество осадков не может быть отрицательным!');
                return false;
            }
            if (area <= 0) {
                alert('Площадь поля должна быть положительной!');
                return false;
            }
            return true;
        }

        function getLocationAndForecast() {
            const crop = document.querySelector('select[name="crop"]').value;
            const area = document.querySelector('input[name="area"]').value;
            const soil_type = document.querySelector('select[name="soil_type"]').value;
            const fertilizer_level = document.querySelector('select[name="fertilizer_level"]').value;

            if (!crop || !area || !soil_type || !fertilizer_level) {
                alert('Пожалуйста, заполните все поля перед определением местоположения!');
                return;
            }

            const locationButton = document.querySelector('input[name="location_button"]');
            locationButton.disabled = true;
            locationButton.value = 'Определяем местоположение...';

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function(position) {
                        const latitude = position.coords.latitude;
                        const longitude = position.coords.longitude;
                        if (latitude === undefined || latitude === null || longitude === undefined || longitude === null) {
                            alert('Не удалось определить координаты. Пожалуйста, попробуйте снова.');
                            locationButton.disabled = false;
                            locationButton.value = 'Определить местоположение';
                            return;
                        }

                        fetch(`/forecast_by_location?latitude=${latitude}&longitude=${longitude}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                crop: crop,
                                area: area,
                                soil_type: soil_type,
                                fertilizer_level: fertilizer_level
                            })
                        })
                        .then(response => response.json())
                        .then(data => {
                            locationButton.disabled = false;
                            locationButton.value = 'Определить местоположение';
                            if (data.error) {
                                alert(data.error);
                            } else {
                                window.location.reload();
                            }
                        })
                        .catch(error => {
                            locationButton.disabled = false;
                            locationButton.value = 'Определить местоположение';
                            alert('Ошибка при запросе прогноза: ' + error);
                        });
                    },
                    function(error) {
                        locationButton.disabled = false;
                        locationButton.value = 'Определить местоположение';
                        let errorMessage = 'Ошибка определения местоположения: ';
                        switch(error.code) {
                            case error.PERMISSION_DENIED:
                                errorMessage += 'Пользователь отклонил запрос на геолокацию. Пожалуйста, разрешите доступ к геолокации в настройках браузера.';
                                break;
                            case error.POSITION_UNAVAILABLE:
                                errorMessage += 'Информация о местоположении недоступна. Убедитесь, что геолокация включена на вашем устройстве.';
                                break;
                            case error.TIMEOUT:
                                errorMessage += 'Истекло время ожидания запроса геолокации. Попробуйте снова.';
                                break;
                            default:
                                errorMessage += 'Произошла неизвестная ошибка.';
                                break;
                        }
                        alert(errorMessage);
                    },
                    {
                        enableHighAccuracy: true,
                        timeout: 10000,
                        maximumAge: 0
                    }
                );
            } else {
                locationButton.disabled = false;
                locationButton.value = 'Определить местоположение';
                alert('Геолокация не поддерживается вашим браузером.');
            }
        }

        function filterHistory() {
            const filterValue = document.getElementById('category-filter').value;
            const rows = document.querySelectorAll('.history-table tr:not(:first-child)');

            rows.forEach(row => {
                const category = row.classList.contains('excellent') ? 'excellent' :
                                row.classList.contains('average') ? 'average' :
                                row.classList.contains('poor') ? 'poor' : '';
                if (filterValue === 'all' || category === filterValue) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        {% if forecast_result %}
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('yieldChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: {{ forecast_result.plot_data.temp_range | tojson }},
                    datasets: [{
                        label: 'Урожайность (т/га)',
                        data: {{ forecast_result.plot_data.yield_values | tojson }},
                        borderColor: 'rgba(76, 175, 80, 1)',
                        backgroundColor: 'rgba(76, 175, 80, 0.2)',
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        x: { title: { display: true, text: 'Температура (°C)' } },
                        y: { title: { display: true, text: 'Урожайность (т/га)' } }
                    }
                }
            });
        });
        {% endif %}
    </script>
</body>
</html>
"""

@app.route('/')
def home():
    try:
        forecast_history = get_forecast_history()
        return render_template_string(HTML_TEMPLATE, forecast_history=forecast_history)
    except Exception as e:
        logger.error(f"Ошибка загрузки главной страницы: {e}")
        return render_template_string(HTML_TEMPLATE, forecast_history=[], forecast_error=str(e))

@app.route('/forecast_yield', methods=['POST'])
def forecast_yield_route():
    try:
        crop = request.form.get('crop')
        avg_temp = float(request.form.get('avg_temp'))
        total_precipitation = float(request.form.get('total_precipitation'))
        area = float(request.form.get('area'))
        soil_type = request.form.get('soil_type')
        fertilizer_level = request.form.get('fertilizer_level')

        if not crop or not soil_type or not fertilizer_level:
            return render_template_string(
                HTML_TEMPLATE,
                forecast_history=get_forecast_history(),
                forecast_error="Ошибка: выберите культуру, тип почвы и уровень удобрений"
            )

        forecast_result, error = forecast_yield(crop, avg_temp, total_precipitation, area, soil_type, fertilizer_level)
        if error:
            return render_template_string(
                HTML_TEMPLATE,
                forecast_history=get_forecast_history(),
                forecast_error=error
            )

        plot_data = generate_yield_plot(crop, forecast_result["plot_data"])
        success, save_error = save_forecast(crop, avg_temp, total_precipitation, area, soil_type, fertilizer_level,
                                            forecast_result)

        if not success:
            logger.error(f"Ошибка сохранения прогноза: {save_error}")

        return render_template_string(
            HTML_TEMPLATE,
            forecast_result=forecast_result,
            forecast_history=get_forecast_history(),
            plot_data=plot_data,
            location="Введено вручную"
        )
    except Exception as e:
        logger.error(f"Ошибка в маршруте прогноза: {e}")
        return render_template_string(
            HTML_TEMPLATE,
            forecast_history=get_forecast_history(),
            forecast_error=f"Произошла ошибка: {str(e)}"
        )

@app.route('/forecast_by_location', methods=['POST'])
def forecast_by_location():
    try:
        latitude_str = request.args.get('latitude')
        longitude_str = request.args.get('longitude')
        logger.info(f"Получены координаты: latitude={latitude_str}, longitude={longitude_str}")

        if not latitude_str or not longitude_str:
            logger.error("Параметры latitude и longitude отсутствуют")
            return {"error": "Ошибка: параметры latitude и longitude отсутствуют"}, 400

        try:
            latitude = float(latitude_str)
            longitude = float(longitude_str)
        except (ValueError, TypeError) as e:
            logger.error(f"Некорректные значения latitude или longitude: {e}")
            return {"error": "Ошибка: некорректные значения latitude или longitude"}, 400

        data = request.get_json()
        crop = data.get('crop')
        area_str = data.get('area')
        soil_type = data.get('soil_type')
        fertilizer_level = data.get('fertilizer_level')
        logger.info(
            f"Получены данные формы: crop={crop}, area={area_str}, soil_type={soil_type}, fertilizer_level={fertilizer_level}")

        if not crop or not area_str or not soil_type or not fertilizer_level:
            logger.error("Все поля формы должны быть заполнены")
            return {"error": "Ошибка: все поля должны быть заполнены"}, 400

        try:
            area = float(area_str)
        except (ValueError, TypeError) as e:
            logger.error(f"Некорректное значение площади: {e}")
            return {"error": "Ошибка: некорректное значение площади"}, 400

        avg_temp, total_precipitation, location = estimate_climate_by_location(latitude, longitude)
        logger.info(
            f"Определены климатические параметры: avg_temp={avg_temp}, total_precipitation={total_precipitation}, location={location}")

        forecast_result, error = forecast_yield(crop, avg_temp, total_precipitation, area, soil_type, fertilizer_level)
        if error:
            logger.error(f"Ошибка прогнозирования: {error}")
            return {"error": error}, 400

        plot_data = generate_yield_plot(crop, forecast_result["plot_data"])
        success, save_error = save_forecast(crop, avg_temp, total_precipitation, area, soil_type, fertilizer_level,
                                            forecast_result, location)

        if not success:
            logger.error(f"Ошибка сохранения прогноза: {save_error}")

        logger.info(f"Прогноз успешно выполнен для {crop} в {location}")
        return {
            "forecast_result": forecast_result,
            "plot_data": plot_data,
            "location": location
        }, 200
    except Exception as e:
        logger.error(f"Ошибка в маршруте прогноза по местоположению: {e}")
        return {"error": str(e)}, 500

@app.route('/clear_history', methods=['POST'])
def clear_history():
    try:
        success, error = clear_forecast_history()
        if not success:
            return render_template_string(
                HTML_TEMPLATE,
                forecast_history=get_forecast_history(),
                forecast_error=f"Ошибка очистки истории: {error}"
            )
        return render_template_string(
            HTML_TEMPLATE,
            forecast_history=get_forecast_history(),
            forecast_message="История успешно очищена"
        )
    except Exception as e:
        logger.error(f"Ошибка в маршруте очистки истории: {e}")
        return render_template_string(
            HTML_TEMPLATE,
            forecast_history=get_forecast_history(),
            forecast_error=f"Произошла ошибка: {str(e)}"
        )

if __name__ == "__main__":
    init_forecast_file()
    app.run(debug=True, host="0.0.0.0", port=5000)
