FORECAST_FILE = "C:/Users/user/PycharmProjects/GPT_Serve/forecast_data.json"
CURRENCIES = ["RUB", "USD", "KZT"]

def init_forecast_file():
    try:
        if not os.path.exists(FORECAST_FILE):
            with open(FORECAST_FILE, "w", encoding="utf-8") as f:
                json.dump([], f)
    except Exception as e:
        logger.error(f"Ошибка инициализации файла прогнозов: {e}")
        raise

def save_forecast(crop, avg_temp, total_precipitation, area, soil_type, fertilizer_level, yield_result,
                  location="Неизвестно"):
    try:
        init_forecast_file()
        with open(FORECAST_FILE, "r", encoding="utf-8") as f:
            forecasts = json.load(f)
        forecasts.append({
            "crop": crop,
            "avg_temp": avg_temp,
            "total_precipitation": total_precipitation,
            "area": area,
            "soil_type": soil_type,
            "fertilizer_level": fertilizer_level,
            "yield_per_ha": yield_result["yield_per_ha"],
            "total_yield": yield_result["total_yield"],
            "temp_adjustment": yield_result["temp_adjustment"],
            "precip_adjustment": yield_result["precip_adjustment"],
            "soil_adjustment": yield_result["soil_adjustment"],
            "fertilizer_adjustment": yield_result["fertilizer_adjustment"],
            "yield_category": yield_result["yield_category"],
            "location": location,
            "timestamp": str(np.datetime64("now"))
        })
        with open(FORECAST_FILE, "w", encoding="utf-8") as f:
            json.dump(forecasts, f, ensure_ascii=False, indent=2)
        return True, None
    except Exception as e:
        return False, str(e)

def get_forecast_history():
    try:
        init_forecast_file()
        with open(FORECAST_FILE, "r", encoding="utf-8") as f:
            forecasts = json.load(f)
        current_time = np.datetime64("now")
        threshold_time = current_time - np.timedelta64(30, 'D')
        forecasts = [f for f in forecasts if np.datetime64(f["timestamp"]) > threshold_time]
        with open(FORECAST_FILE, "w", encoding="utf-8") as f:
            json.dump(forecasts, f, ensure_ascii=False, indent=2)
        return forecasts
    except Exception as e:
        logger.error(f"Ошибка чтения истории прогнозов: {e}")
        return []

def clear_forecast_history():
    try:
        init_forecast_file()
        with open(FORECAST_FILE, "w", encoding="utf-8") as f:
            json.dump([], f)
        return True, None
    except Exception as e:
        logger.error(f"Ошибка очистки истории прогнозов: {e}")
        return False, str(e)

def generate_yield_plot(crop, yield_data):
    try:
        plt.figure(figsize=(8, 6))
        plt.plot(yield_data["temp_range"], yield_data["yield_values"], 'b-', label=f'Урожайность {crop}')
        plt.title(f'Прогноз урожайности для {crop}')
        plt.xlabel('Средняя температура (°C)')
        plt.ylabel('Урожайность (т/га)')
        plt.grid(True)
        plt.legend()

        buffer = BytesIO()
        plt.savefig(buffer, format='png')
        buffer.seek(0)
        plot_data = base64.b64encode(buffer.getvalue()).decode('utf-8')
        plt.close()
        return plot_data
    except Exception as e:
        logger.error(f"Ошибка генерации графика: {e}")
        return None

