        precip_factor = coeffs["precip_factor"]
        optimal_temp = coeffs["optimal_temp"]
        optimal_precip = coeffs["optimal_precip"]
        soil_factor = coeffs["soil_factors"].get(soil_type, 1.0)
        fertilizer_factor = coeffs["fertilizer_factors"].get(fertilizer_level, 1.0)

        temp_deviation = abs(avg_temp - optimal_temp)
        temp_adjustment = max(0, 1 - temp_deviation * temp_factor)

        precip_deviation = abs(total_precipitation - optimal_precip)
        precip_adjustment = max(0, 1 - precip_deviation * precip_factor)

        adjusted_yield_per_ha = base_yield * temp_adjustment * precip_adjustment * soil_factor * fertilizer_factor
        total_yield = adjusted_yield_per_ha * area

        yield_ratio = adjusted_yield_per_ha / base_yield
        if yield_ratio >= 0.75:
            yield_category = "excellent"
        elif yield_ratio >= 0.4:
            yield_category = "average"
        else:
            yield_category = "poor"

        temp_range = np.linspace(avg_temp - 10, avg_temp + 10, 100)
        yield_values = [
            base_yield * max(0, 1 - abs(
                t - optimal_temp) * temp_factor) * precip_adjustment * soil_factor * fertilizer_factor
            for t in temp_range
        ]

        return {
            "yield_per_ha": round(adjusted_yield_per_ha, 2),
            "total_yield": round(total_yield, 2),
            "temp_adjustment": round(temp_adjustment * 100, 2),
            "precip_adjustment": round(precip_adjustment * 100, 2),
            "soil_adjustment": round(soil_factor * 100, 2),
            "fertilizer_adjustment": round(fertilizer_factor * 100, 2),
            "plot_data": {
                "temp_range": temp_range.tolist(),
                "yield_values": yield_values
            },
            "yield_category": yield_category
        }, None
    except Exception as e:
        return None, f"Ошибка при прогнозировании: {str(e)}"

def estimate_climate_by_location(latitude, longitude):
    if latitude is None or longitude is None:
        return 20.0, 500.0, "Неизвестно"

    if latitude > 50:
        if 60 <= longitude <= 70:
            location = "Северный Казахстан (например, Петропавловск)"
            avg_temp = 15.0
            total_precipitation = 400.0
        elif longitude < 60:
            location = "Северо-Западный Казахстан (например, Костанай)"
            avg_temp = 16.0
            total_precipitation = 350.0
        else:
            location = "Северо-Восточный Казахстан (например, Павлодар)"
            avg_temp = 15.5
            total_precipitation = 380.0

    elif 48 <= latitude <= 50:
        if longitude < 60:
            location = "Западный Казахстан (например, Актобе)"
            avg_temp = 18.0
            total_precipitation = 300.0
        elif 60 <= longitude <= 80:
            if 50.5 <= latitude <= 51.5 and 70 <= longitude <= 72:
                location = "Центральный Казахстан (Астана)"
                avg_temp = 17.0
                total_precipitation = 320.0
            else:
                location = "Центральный Казахстан (например, Караганда)"
                avg_temp = 17.5
                total_precipitation = 340.0
        else:
            location = "Восточный Казахстан (например, Усть-Каменогорск)"
            avg_temp = 16.5
            total_precipitation = 400.0

    else:
        if 75 <= longitude <= 78:
            location = "Южный Казахстан (Алматы)"
            avg_temp = 22.0
            total_precipitation = 600.0
        elif 68 <= longitude <= 72:
            location = "Южный Казахстан (например, Шымкент или Тараз)"
            avg_temp = 23.0
            total_precipitation = 550.0
        else:
            location = "Юго-Западный Казахстан (например, Кызылорда)"
            avg_temp = 24.0
            total_precipitation = 250.0

    return avg_temp, total_precipitation, location

